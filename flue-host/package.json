{
  "name": "buzz-flue-host",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Flue-based ACP agent host for Buzz: flue-acp adapter bridging buzz-acp (ACP over stdio) to a Flue agent session.",
  "license": "Apache-2.0",
  "bin": {
    "flue-acp": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/main.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "pnpm build && tsx scripts/live-smoke.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.71",
    "@earendil-works/pi-ai": "0.83.0",
    "@flue/runtime": "2.0.3"
  },
  "devDependencies": {
    "@flue/cli": "2.0.1",
    "@types/node": "26.1.2",
    "tsx": "4.23.5",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
